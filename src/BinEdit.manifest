<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!-- Native application identity and process-wide Windows compatibility declarations. -->
  <!-- x64-only identity matches the sole solution platform. -->
  <assemblyIdentity version="1.0.0.0" processorArchitecture="amd64" name="BinEdit" type="win32"/>
  <description>BinEdit binary editor</description>
  <!-- Version 6 common controls keep native file/color dialogs visually current. -->
  <dependency><dependentAssembly><assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0" processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*"/></dependentAssembly></dependency>
  <!-- Elevation is requested only for the explicit staged-save relaunch. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3"><security><requestedPrivileges><requestedExecutionLevel level="asInvoker" uiAccess="false"/></requestedPrivileges></security></trustInfo>
  <!-- Per-Monitor-V2 coordinates and long filesystem paths are process-wide contracts. -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3"><windowsSettings><dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness><longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware></windowsSettings></application>
</assembly>
